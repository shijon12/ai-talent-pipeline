# Local development defaults for AI Talent Pipeline
#
# docker-compose.yml currently defines these values directly.
# This file is here as a reference if you later externalize compose config.

POSTGRES_DB=pipeline_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_PORT=5432

KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_BROKER=kafka:29092

INGESTION_SERVICE_PORT=8081
SCORING_SERVICE_PORT=8082
SCHEDULING_SERVICE_PORT=8083
KAFDROP_PORT=9000

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b

